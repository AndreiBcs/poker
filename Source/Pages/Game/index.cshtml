@page
@model IndexModel

@{
    ViewData["Title"] = "Game";
}

<div class="game-container" data-lobby-id="@Model.LobbyId" data-is-leader="@Model.IsLeader.ToString().ToLowerInvariant()">

    <!-- Header with lobby info -->
    <div class="game-header">
        @if (Model.LobbyId.HasValue)
        {
            <div class="lobby-banner">
                @Model.LobbyName (Blinds $@Model.SmallBlind / $@Model.BigBlind)
            </div>
        }
        <div class="game-info-top">
            <div class="info-item">
                <span class="label">Phase:</span>
                <span id="phaseValue" class="value">Waiting</span>
            </div>
            <div class="info-item">
                <span class="label">Pot:</span>
                <span id="potValue" class="value">$0</span>
            </div>
        </div>
    </div>

    <!-- Top Right Controls -->
    <div class="top-right-controls">
        <button id="leaveGameBtn" class="control-btn btn-danger">Leave Game</button>
    </div>

    <div class="game-stage">
        <!-- Player Cards (Left Side) -->
        <div class="player-hand-dock">
            <div class="player-hand-container">
                <div class="your-cards" id="playerHoleCards"></div>
            </div>
        </div>

        <!-- Poker Table -->
        <div class="poker-table-wrapper">
            <!-- Players Circle -->
            <div class="players-circle" id="playersContainer"></div>

            <!-- Community Cards (Center) -->
            <div class="community-cards-container">
                <div class="community-cards" id="boardCards"></div>
            </div>
        </div>
    </div>

    <!-- Action Modal (appears dynamically) -->
    <div id="actionModal" class="action-modal" style="display:none;">
        <div class="action-modal-content">
            <div class="modal-header" id="modalHeader"></div>
            <div class="modal-body" id="modalActions"></div>
        </div>
    </div>

    <!-- Bottom Control Panel (Actions) -->
    <div class="control-panel" id="actionPanel">
        <!-- Player actions will be rendered here -->
    </div>

</div>

<!-- Modal for raise input -->
<div id="raiseModal" class="raise-modal" style="display:none;">
    <div class="raise-modal-content">
        <h3>How much to raise?</h3>
        <div class="raise-input-group">
            <input id="raiseAmount" type="number" min="1" value="50" placeholder="Amount" />
            <button id="confirmRaise" class="btn-confirm">Raise</button>
            <button id="cancelRaise" class="btn-cancel">Cancel</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/game.js" asp-append-version="true"></script>
}