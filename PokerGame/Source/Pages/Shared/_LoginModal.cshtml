@model Source.Pages.IndexModel

<div id="loginModal" class="modal" style="display:none;">
    <div class="modal-content">
        <h2>Login</h2>

        <form method="post" asp-page-handler="Login">
            <div asp-validation-summary="ModelOnly"></div>

            <input asp-for="Login.Email" type="email" placeholder="Email" />
            <span asp-validation-for="Login.Email"></span>

            <input asp-for="Login.Password" type="password" placeholder="Password" />
            <span asp-validation-for="Login.Password"></span>

            <button type="submit">Login</button>
            <button type="button" onclick="closeLogin()">Close</button>
        </form>
    </div>
</div>
