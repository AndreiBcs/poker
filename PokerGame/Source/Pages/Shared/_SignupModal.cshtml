@model Source.Pages.IndexModel

<div id="signupModal" class="modal" style="display:none;">
    <h2 class="modal-header">Sign Up</h2>
    <button class="close-modal-btn" type="button" onclick="closeSignup()">x</button>

    <form method="post" asp-page-handler="Signup">
        <div asp-validation-summary="All"></div>

        <input asp-for="Signup.Username" placeholder="Username" />
        <span asp-validation-for="Signup.Username"></span>

        <input asp-for="Signup.Email" type="email" placeholder="Email" />
        <span asp-validation-for="Signup.Email"></span>

        <input asp-for="Signup.Password" type="password" placeholder="Password" />
        <span asp-validation-for="Signup.Password"></span>

        <button type="submit">Create Account</button>
    </form>
</div>
